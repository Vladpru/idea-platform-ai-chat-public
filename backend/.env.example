NODE_ENV=development
APP_ENV=development

APP_PORT=3001

DATABASE_URL=

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
TOKEN_COOKIE_NAME=refreshToken

SERVER_DOMAIN=localhost

# Optional: public API base for avatar URLs (no trailing slash). Defaults to http://localhost:APP_PORT
# APP_PUBLIC_URL="http://localhost:3001"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY="123123"
CLOUDINARY_API_SECRET="cweof"

# SendGrid (transactional email; FROM must be a verified sender in SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=your-verified-sender@example.com

# Base URL for password-reset links (no trailing slash). Local dev uses Vite; on Render set to the deployed frontend.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# Gemini AI (Google AI Studio key — https://aistudio.google.com/apikey , starts with AIza)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=10000
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIMEOUT_MS=15000
SEARCH_MIN_SIMILARITY=0.3