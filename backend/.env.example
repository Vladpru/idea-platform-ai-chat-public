
NODE_ENV=development
APP_ENV=development

APP_PORT=3001

DATABASE_URL=

REDIS_URL=redis://localhost:6379

# Realtime transport strangler seam: `direct` (in-process Socket.IO, default) or
# `redis` (publish to the edge:downstream stream for the future FastAPI edge).
# Keep on `direct` until the edge exists and the NestJS WS server is bypassed.
REALTIME_TRANSPORT=direct

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
TOKEN_COOKIE_NAME=refreshToken

SERVER_DOMAIN=localhost

# Optional: public API base for avatar URLs (no trailing slash). Defaults to http://localhost:APP_PORT
# APP_PUBLIC_URL="http://localhost:3001"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY="123123"
CLOUDINARY_API_SECRET="cweof"

# SendGrid (transactional email; FROM must be a verified sender in SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=your-verified-sender@example.com

# Base URL for password-reset links (no trailing slash). Local dev uses Vite; on Render set to the deployed frontend.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# Gemini AI (Google AI Studio key — https://aistudio.google.com/apikey , starts with AIza)
# Embedding/search tuning (model, timeouts, similarity) lives in src/config/*.config.ts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=10000
GEMINI_TAG_SUGGESTIONS_TIMEOUT_MS=15000
LLM_PROVIDER=gemini
LLM_AGENT_MODEL=gemini-2.5-flash
LLM_LIGHT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
AI_CHAT_FOLLOWUPS_ENABLED=true
AI_CHAT_SOURCES_ENABLED=true
AI_TAG_SUGGESTIONS_ENABLED=true

# deAPI FLUX.1 Schnell — POST /ai-image/generate (https://deapi.ai)
DEAPI_API_KEY=
DEAPI_BASE_URL=https://api.deapi.ai
DEAPI_IMAGE_MODEL=Flux1schnell
DEAPI_IMAGE_TIMEOUT_MS=120000
DEAPI_POLL_INTERVAL_MS=2000
DEAPI_USE_PROMPT_ENHANCEMENT=true

GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIMEOUT_MS=15000
SEARCH_MIN_SIMILARITY=0.65

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

PDF_SERVICE_URL=http://localhost:8000
PDF_INTERNAL_SECRET=<shared-secret>

# PostHog AI observability (optional — omit to disable backend AI tracking)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error monitoring
SENTRY_DSN=
APP_VERSION=

# Absolute path to the Obsidian vault folder used as the RAG knowledge base
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian-vault