generator client {
  provider        = "prisma-client"
  previewFeatures = ["fullTextSearchPostgres"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdeaStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProblemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Stage {
  ideation
  prototyping
  completed
  archived
  paused
}

enum ProblemStage {
  active
  completed
  archived
}

enum MediaKind {
  MAIN_IMAGE
  ATTACHMENT
}

enum MediaProvider {
  CLOUDINARY
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  firstName           String?              @map("first_name")
  lastName            String?              @map("last_name")
  password            String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  avatarUrl           String?              @map("avatar_url")
  passwordResetTokens PasswordResetToken[]
  ideas               Idea[]               @relation("IdeaAuthor")
  problems            Problem[]
  joinedIdeas         IdeaMember[]
  joinedProblems      ProblemMember[]
  ideaLikes           IdeaLike[]
  problemLikes        ProblemLike[]
  ideaViews           IdeaView[]
  problemViews        ProblemView[]
  comments            Comment[]            @relation("CommentAuthor")
  commentLikes        CommentLike[]

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Idea {
  id            String                      @id @default(uuid())
  authorId      String                      @map("author_id")
  status        IdeaStatus                  @default(DRAFT)
  stage         Stage?
  title         String?
  description   String?                     @db.Text
  viewCount     Int                         @default(0) @map("view_count")
  likeCount     Int                         @default(0) @map("like_count")
  commentCount  Int                         @default(0) @map("comment_count")
  publishedAt   DateTime?                   @map("published_at")
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")
  searchVector  Unsupported("tsvector")?    @map("search_vector")
  aiEmbedding   Unsupported("vector(768)")? @map("ai_embedding")
  embeddingHash String?                     @map("embedding_hash")

  author   User          @relation("IdeaAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  problems IdeaProblem[]
  tags     IdeaTag[]
  media    IdeaMedia[]
  members  IdeaMember[]
  likes    IdeaLike[]
  views    IdeaView[]
  comments Comment[]

  @@index([authorId, status])
  @@index([status, publishedAt])
  @@index([searchVector], type: Gin)
  @@map("idea")
}

model IdeaMember {
  ideaId   String   @map("idea_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
  @@index([userId])
  @@map("idea_member")
}

model IdeaView {
  id        String   @id @default(uuid())
  ideaId    String   @map("idea_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([userId])
  @@map("idea_view")
}

model IdeaLike {
  ideaId    String   @map("idea_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
  @@index([userId])
  @@map("idea_like")
}

model Problem {
  id               String                      @id @default(uuid())
  authorId         String                      @map("author_id")
  title            String
  description      String                      @db.Text
  status           ProblemStatus               @default(DRAFT)
  stage            ProblemStage?
  valueProposition String?                     @map("value_proposition")
  costBenefit      Decimal?                    @map("cost_benefit") @db.Decimal(12, 2)
  category         String?
  impact           String?
  viewCount        Int                         @default(0) @map("view_count")
  likeCount        Int                         @default(0) @map("like_count")
  commentCount     Int                         @default(0) @map("comment_count")
  publishedAt      DateTime?                   @map("published_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  searchVector     Unsupported("tsvector")?    @map("search_vector")
  aiEmbedding      Unsupported("vector(768)")? @map("ai_embedding")
  embeddingHash    String?                     @map("embedding_hash")

  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  members  ProblemMember[]
  ideas    IdeaProblem[]
  media    ProblemMedia[]
  tags     ProblemTag[]
  likes    ProblemLike[]
  views    ProblemView[]
  comments Comment[]

  @@index([authorId, status])
  @@index([status])
  @@index([searchVector], type: Gin)
  @@map("problem")
}

model ProblemView {
  id        String   @id @default(uuid())
  problemId String   @map("problem_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
  @@index([userId])
  @@map("problem_view")
}

model ProblemLike {
  problemId String   @map("problem_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([problemId, userId])
  @@index([userId])
  @@map("problem_like")
}

model Tag {
  id            String                      @id @default(uuid())
  name          String                      @unique
  label         String?
  aiEmbedding   Unsupported("vector(768)")? @map("ai_embedding")
  embeddingHash String?                     @map("embedding_hash")
  createdAt     DateTime                    @default(now()) @map("created_at")

  ideas       IdeaTag[]
  problemTags ProblemTag[]

  @@map("tag")
}

model IdeaProblem {
  ideaId    String  @map("idea_id")
  problemId String  @map("problem_id")
  isPrimary Boolean @default(false) @map("is_primary")

  idea    Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([ideaId, problemId])
  @@map("idea_problem")
}

model IdeaTag {
  ideaId String @map("idea_id")
  tagId  String @map("tag_id")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
  @@map("idea_tag")
}

model ProblemTag {
  problemId String @map("problem_id")
  tagId     String @map("tag_id")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@map("problem_tag")
}

model IdeaMedia {
  id               String        @id @default(uuid())
  ideaId           String        @map("idea_id")
  kind             MediaKind
  provider         MediaProvider @default(CLOUDINARY)
  url              String
  publicId         String        @map("public_id")
  mimeType         String        @map("mime_type")
  byteSize         Int           @map("byte_size")
  originalFilename String        @map("original_filename")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId, kind])
  @@map("idea_media")
}

model ProblemMedia {
  id               String        @id @default(uuid())
  problemId        String        @map("problem_id")
  kind             MediaKind
  provider         MediaProvider @default(CLOUDINARY)
  url              String
  publicId         String        @map("public_id")
  mimeType         String        @map("mime_type")
  byteSize         Int           @map("byte_size")
  originalFilename String        @map("original_filename")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, kind])
  @@map("problem_media")
}

model ProblemMember {
  problemId String   @map("problem_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([problemId, userId])
  @@index([userId])
  @@map("problem_member")
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  authorId  String   @map("author_id")
  ideaId    String?  @map("idea_id")
  problemId String?  @map("problem_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  author  User           @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  idea    Idea?          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  problem Problem?       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  parent  Comment?       @relation("CommentQuote", fields: [parentId], references: [id], onDelete: SetNull)
  quotes  Comment[]      @relation("CommentQuote")
  likes   CommentLike[]
  media   CommentMedia[]

  @@index([ideaId, createdAt])
  @@index([problemId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("comment")
}

model CommentLike {
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_like")
}

model CommentMedia {
  id               String        @id @default(uuid())
  commentId        String        @map("comment_id")
  provider         MediaProvider @default(CLOUDINARY)
  url              String
  publicId         String        @map("public_id")
  mimeType         String        @map("mime_type")
  byteSize         Int           @map("byte_size")
  originalFilename String        @map("original_filename")
  createdAt        DateTime      @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_media")
}
