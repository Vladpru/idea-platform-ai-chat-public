generator client {
  provider        = "prisma-client"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
  output          = "../generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum IdeaStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProblemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Stage {
  ideation
  prototyping
  completed
  archived
  paused
}

enum ProblemStage {
  active
  completed
  archived
}

enum MediaKind {
  MAIN_IMAGE
  ATTACHMENT
}

enum MediaProvider {
  CLOUDINARY
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum SummaryStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

enum VideoCallStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum ConferenceStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ConferenceInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ConferenceInviteType {
  PLATFORM_USER
  EXTERNAL_EMAIL
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  firstName               String?               @map("first_name")
  lastName                String?               @map("last_name")
  password                String?
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  avatarUrl               String?               @map("avatar_url")
  themePreference         ThemePreference       @default(SYSTEM) @map("theme_preference")
  role                    UserRole              @default(MEMBER)
  notificationPreferences Json                  @default("{}") @map("notification_preferences")
  passwordResetTokens     PasswordResetToken[]
  ideas                   Idea[]                @relation("IdeaAuthor")
  problems                Problem[]
  joinedIdeas             IdeaMember[]
  joinedProblems          ProblemMember[]
  ideaLikes               IdeaLike[]
  problemLikes            ProblemLike[]
  ideaViews               IdeaView[]
  problemViews            ProblemView[]
  comments                Comment[]             @relation("CommentAuthor")
  commentLikes            CommentLike[]
  notifications           Notification[]
  subscriptionsGiven      Subscription[]        @relation("SubscriptionFollower")
  subscriptionsReceived   Subscription[]        @relation("SubscriptionFollowing")
  bio                     String?
  socialLinks             Json?                 @default("[]") @map("social_links")
  liveChatRoomsCreated    LiveChatRoom[]        @relation("LiveChatRoomCreator")
  liveChatParticipations  LiveChatParticipant[]
  liveChatMessages        LiveChatMessage[]     @relation("LiveChatMessageAuthor")
  hostedVideoCalls        VideoCall[]           @relation("VideoCallHost")
  scheduledConferences    Conference[]          @relation("ConferenceScheduler")
  conferenceInvitesSent   ConferenceInvite[]    @relation("ConferenceInviteSender")
  conferenceInvitesRecv   ConferenceInvite[]    @relation("ConferenceInviteRecipient")

  userAchievements UserAchievement[]
  chatMessages     ChatMessage[]
  chatSessions     ChatSession[]

  @@map("user")
}

model Achievement {
  id               String            @id @default(uuid())
  key              String            @unique
  name             String
  description      String
  iconPath         String            @map("icon_path")
  threshold        Int?
  createdAt        DateTime          @default(now()) @map("created_at")
  userAchievements UserAchievement[]

  @@map("achievement")
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  achievementId String    @map("achievement_id")
  unlockedAt    DateTime  @default(now()) @map("unlocked_at")
  seenAt        DateTime? @map("seen_at")
  metadata      Json?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@index([userId])
  @@index([achievementId])
  @@map("user_achievement")
}

model Subscription {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("SubscriptionFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("SubscriptionFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("subscription")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Idea {
  id                 String                      @id @default(uuid())
  authorId           String                      @map("author_id")
  status             IdeaStatus                  @default(DRAFT)
  stage              Stage?
  title              String?
  description        String?                     @db.Text
  viewCount          Int                         @default(0) @map("view_count")
  likeCount          Int                         @default(0) @map("like_count")
  commentCount       Int                         @default(0) @map("comment_count")
  publishedAt        DateTime?                   @map("published_at")
  completedAt        DateTime?                   @map("completed_at")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
 searchVector       Unsupported("tsvector")?    @map("search_vector") @default(dbgenerated())
  aiEmbedding        Unsupported("vector(768)")? @map("ai_embedding")
  embeddingHash      String?                     @map("embedding_hash")
  aiSummary          String?                     @map("ai_summary") @db.Text
  summaryStatus      SummaryStatus               @default(SKIPPED) @map("summary_status")
  summaryRequestedAt DateTime?                   @map("summary_requested_at")
  version            Int                         @default(1)

  author       User          @relation("IdeaAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  problems     IdeaProblem[]
  tags         IdeaTag[]
  media        IdeaMedia[]
  members      IdeaMember[]
  likes        IdeaLike[]
  views        IdeaView[]
  comments     Comment[]
  liveChatRoom LiveChatRoom?
  conferences  Conference[]

  @@index([authorId, status])
  @@index([status, publishedAt])
  @@index([searchVector], type: Gin)
  @@index([aiEmbedding], map: "idea_ai_embedding_hnsw_idx")
  @@map("idea")
}

model Conference {
  id               String           @id @default(uuid())
  ideaId           String?          @map("idea_id")
  problemId        String?          @map("problem_id")
  scheduledById    String           @map("scheduled_by_id")
  title            String
  description      String?          @db.Text
  status           ConferenceStatus @default(SCHEDULED)
  scheduledFor     DateTime         @map("scheduled_for")
  startedAt        DateTime?        @map("started_at")
  endedAt          DateTime?        @map("ended_at")
  providerRoomName String?          @map("provider_room_name")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  idea        Idea?              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  problem     Problem?           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  scheduledBy User               @relation("ConferenceScheduler", fields: [scheduledById], references: [id], onDelete: Cascade)
  invites     ConferenceInvite[]

  @@index([ideaId, status])
  @@index([problemId, status])
  @@index([ideaId, scheduledFor])
  @@index([problemId, scheduledFor])
  @@index([scheduledById])
  @@map("conference")
}

model ConferenceInvite {
  id           String                 @id @default(uuid())
  conferenceId String                 @map("conference_id")
  invitedById  String                 @map("invited_by_id")
  inviteType   ConferenceInviteType   @map("invite_type")
  status       ConferenceInviteStatus @default(PENDING)
  userId       String?                @map("user_id")
  email        String?
  tokenHash    String?                @map("token_hash")
  expiresAt    DateTime?              @map("expires_at")
  acceptedAt   DateTime?              @map("accepted_at")
  createdAt    DateTime               @default(now()) @map("created_at")

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  invitedBy  User             @relation("ConferenceInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  user       User?            @relation("ConferenceInviteRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@unique([conferenceId, email])
  @@index([userId])
  @@index([email])
  @@index([conferenceId, status])
  @@map("conference_invite")
}

model IdeaMember {
  ideaId   String   @map("idea_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
  @@index([userId])
  @@map("idea_member")
}

model IdeaView {
  id        String   @id @default(uuid())
  ideaId    String   @map("idea_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([userId])
  @@map("idea_view")
}

model IdeaLike {
  ideaId    String   @map("idea_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
  @@index([userId])
  @@map("idea_like")
}

model Problem {
  id                 String                      @id @default(uuid())
  authorId           String                      @map("author_id")
  title              String
  description        String                      @db.Text
  status             ProblemStatus               @default(DRAFT)
  stage              ProblemStage?
  valueProposition   String?                     @map("value_proposition")
  costBenefit        Decimal?                    @map("cost_benefit") @db.Decimal(12, 2)
  category           String?
  impact             String?
  viewCount          Int                         @default(0) @map("view_count")
  likeCount          Int                         @default(0) @map("like_count")
  commentCount       Int                         @default(0) @map("comment_count")
  publishedAt        DateTime?                   @map("published_at")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
searchVector       Unsupported("tsvector")?    @map("search_vector") @default(dbgenerated())
  aiEmbedding        Unsupported("vector(768)")? @map("ai_embedding")
  embeddingHash      String?                     @map("embedding_hash")
  aiSummary          String?                     @map("ai_summary") @db.Text
  summaryStatus      SummaryStatus               @default(SKIPPED) @map("summary_status")
  summaryRequestedAt DateTime?                   @map("summary_requested_at")
  version            Int                         @default(1)

  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  members      ProblemMember[]
  ideas        IdeaProblem[]
  media        ProblemMedia[]
  tags         ProblemTag[]
  likes        ProblemLike[]
  views        ProblemView[]
  comments     Comment[]
  liveChatRoom LiveChatRoom?
  conferences  Conference[]

  @@index([authorId, status])
  @@index([status])
  @@index([searchVector], type: Gin)
  @@index([aiEmbedding], map: "problem_ai_embedding_hnsw_idx")
  @@map("problem")
}

model ProblemView {
  id        String   @id @default(uuid())
  problemId String   @map("problem_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
  @@index([userId])
  @@map("problem_view")
}

model ProblemLike {
  problemId String   @map("problem_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([problemId, userId])
  @@index([userId])
  @@map("problem_like")
}

model Tag {
  id            String                      @id @default(uuid())
  name          String                      @unique
  label         String?
  aiEmbedding   Unsupported("vector(768)")? @map("ai_embedding")
  embeddingHash String?                     @map("embedding_hash")
  createdAt     DateTime                    @default(now()) @map("created_at")

  ideas       IdeaTag[]
  problemTags ProblemTag[]

  @@index([aiEmbedding], map: "tag_ai_embedding_hnsw_idx")
  @@map("tag")
}

model IdeaProblem {
  ideaId    String  @map("idea_id")
  problemId String  @map("problem_id")
  isPrimary Boolean @default(false) @map("is_primary")

  idea    Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([ideaId, problemId])
  @@map("idea_problem")
}

model IdeaTag {
  ideaId String @map("idea_id")
  tagId  String @map("tag_id")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
  @@map("idea_tag")
}

model ProblemTag {
  problemId String @map("problem_id")
  tagId     String @map("tag_id")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@map("problem_tag")
}

model IdeaMedia {
  id               String        @id @default(uuid())
  ideaId           String        @map("idea_id")
  kind             MediaKind
  provider         MediaProvider @default(CLOUDINARY)
  url              String
  publicId         String        @map("public_id")
  mimeType         String        @map("mime_type")
  byteSize         Int           @map("byte_size")
  originalFilename String        @map("original_filename")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId, kind])
  @@map("idea_media")
}

model ProblemMedia {
  id               String        @id @default(uuid())
  problemId        String        @map("problem_id")
  kind             MediaKind
  provider         MediaProvider @default(CLOUDINARY)
  url              String
  publicId         String        @map("public_id")
  mimeType         String        @map("mime_type")
  byteSize         Int           @map("byte_size")
  originalFilename String        @map("original_filename")
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, kind])
  @@map("problem_media")
}

model ProblemMember {
  problemId String   @map("problem_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([problemId, userId])
  @@index([userId])
  @@map("problem_member")
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  authorId  String   @map("author_id")
  ideaId    String?  @map("idea_id")
  problemId String?  @map("problem_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  author  User           @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  idea    Idea?          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  problem Problem?       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  parent  Comment?       @relation("CommentQuote", fields: [parentId], references: [id], onDelete: SetNull)
  quotes  Comment[]      @relation("CommentQuote")
  likes   CommentLike[]
  media   CommentMedia[]

  @@index([ideaId, createdAt])
  @@index([problemId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("comment")
}

model CommentLike {
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_like")
}

model CommentMedia {
  id               String        @id @default(uuid())
  commentId        String        @map("comment_id")
  provider         MediaProvider @default(CLOUDINARY)
  url              String
  publicId         String        @map("public_id")
  mimeType         String        @map("mime_type")
  byteSize         Int           @map("byte_size")
  originalFilename String        @map("original_filename")
  createdAt        DateTime      @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_media")
}

model LiveChatRoom {
  id            String   @id @default(uuid())
  ideaId        String?  @unique @map("idea_id")
  problemId     String?  @unique @map("problem_id")
  directPairKey String?  @unique @map("direct_pair_key")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  idea         Idea?                 @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  problem      Problem?              @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("LiveChatRoomCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants LiveChatParticipant[]
  messages     LiveChatMessage[]
  videoCalls   VideoCall[]

  @@map("live_chat_room")
}

model VideoCall {
  id               String          @id @default(uuid())
  roomId           String          @map("room_id")
  hostId           String          @map("host_id")
  status           VideoCallStatus @default(SCHEDULED)
  scheduledFor     DateTime?       @map("scheduled_for")
  startedAt        DateTime?       @map("started_at")
  endedAt          DateTime?       @map("ended_at")
  providerRoomName String?         @map("provider_room_name")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  room LiveChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host User         @relation("VideoCallHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([roomId, scheduledFor])
  @@index([hostId])
  @@map("video_call")
}

model LiveChatParticipant {
  id       String   @id @default(uuid())
  roomId   String   @map("room_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  room LiveChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("live_chat_participant")
}

model LiveChatMessage {
  id                 String   @id @default(uuid())
  roomId             String   @map("room_id")
  authorId           String   @map("author_id")
  clientMessageId    String   @map("client_message_id")
  content            String   @db.Text
  attachmentUrl      String?  @map("attachment_url")
  attachmentName     String?  @map("attachment_name")
  attachmentMimeType String?  @map("attachment_mime_type")
  createdAt          DateTime @default(now()) @map("created_at")

  room   LiveChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User         @relation("LiveChatMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, clientMessageId], map: "live_chat_message_author_id_client_message_id_key")
  @@index([roomId, createdAt])
  @@map("live_chat_message")
}

model KnowledgeChunk {
  id        String                      @id @default(uuid())
  source    String
  content   String                      @db.Text
  embedding Unsupported("vector(768)")?
  metadata  Json                        @default("{}")
  fileHash  String?                     @map("file_hash")
  createdAt DateTime                    @default(now()) @map("created_at")

  @@index([source])
  @@map("knowledge_chunk")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  userId    String      @map("user_id")
  role      String
  content   String      @db.Text
  sources   Json        @default("[]")
  createdAt DateTime    @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_message")
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  summary             String?  @db.Text
  summaryMessageCount Int      @default(0) @map("summary_message_count")
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("chat_session")
}
